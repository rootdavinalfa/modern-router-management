# Web server port (if changed, update BETTER_AUTH_URL and CORS_ORIGIN in apps/api/.env)
PORT=3000

# API Base URL
VITE_API_URL=http://localhost:3001

# Enable TanStack DevTools (true/false)
TANSTACK_VITE_DEVTOOLS=false

# Better Auth (secret required when running the built server; generate: bunx --bun @better-auth/cli secret)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
